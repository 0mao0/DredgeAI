# 依赖目录
node_modules/
**/node_modules/

# 构建产物
dist/
**/dist/
build/
**/build/
*.local

# 日志文件
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 环境变量文件（含敏感信息）
.env
.env.local
.env.*.local
**/.env
**/.env.local
**/.env.*.local
**/appsettings.secrets.json

# 编辑器 / IDE 配置
.vscode/
**/.vscode/
.idea/
**/.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Trae IDE 工作目录
.trae/
**/.trae/
.opencode/

# 本地磁盘存储根目录（开发模式 Local 存储，文件不入库）
**/App_Data/

# 运行时数据总目录（基础数据/业务文件/PostgreSQL/日志/备份，统一不入库）
/data/

# 包管理器锁文件（项目使用 pnpm，忽略其他包管理器的锁文件）
package-lock.json
**/package-lock.json
yarn.lock
**/yarn.lock

# TypeScript 缓存
*.tsbuildinfo
**/*.tsbuildinfo

# Vite 缓存
.vite/
**/.vite/

# 构建工具配置的类型声明产物（由 TS 编译生成，不应入库）
vite.config.d.ts
**/vite.config.d.ts
vite.config.js
**/vite.config.js
uno.config.d.ts
**/uno.config.d.ts

# 测试覆盖率
coverage/
**/coverage/
*.lcov

# 系统文件
.DS_Store
**/.DS_Store
Thumbs.db
**/Thumbs.db
ehthumbs.db
Desktop.ini

# 临时文件
*.tmp
*.temp
.cache/
**/.cache/

.superpowers/

# Python
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
**/.pytest_cache/
*.egg-info/

# 本地包缓存 / 测试标书（不入库）
.pnpm-store/
tests/

# pdf.js 运行资源（由 user-web vite 插件启动时复制到 public，不入库）
**/public/cmaps/
**/public/standard_fonts/
**/public/wasm/

# meeting-bot models & runtimes
services/meeting-bot/models/
services/meeting-bot/.venv-tts/
services/meeting-bot/third_party/
services/meeting-bot/.scratch/
services/meeting-bot/*.log
