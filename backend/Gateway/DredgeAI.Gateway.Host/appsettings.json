{
  "App": {
    "SelfUrl": "https://localhost:7237/",
    "CorsOrigins": "http://localhost:5173,http://localhost:8085"
  },
  "AuthServer": {
    "Authority": "https://localhost:7233/",
    "RequireHttpsMetadata": false
  },
  "Settings": {
    "Abp.Localization.DefaultLanguage": "zh-Hans"
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 10,
    "QueueLimit": 0
  },
  "ReverseProxy": {
    "Routes": {
      "auth-connect-route": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/connect/{**catch-all}" }
      },
      "auth-discovery-route": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/.well-known/{**catch-all}" }
      },
      "auth-account-route": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/Account/{**catch-all}" }
      },
      "auth-libs-route": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/libs/{**catch-all}" }
      },
      "auth-themes-route": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/themes/{**catch-all}" }
      },
      "auth-bundles-route": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/__bundles/{**catch-all}" }
      },
      "auth-abp-scripts-route": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/Abp/{**catch-all}" }
      },
      "base-abp-route": {
        "ClusterId": "base-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/abp/{**catch-all}" }
      },
      "base-file-v3-route": {
        "ClusterId": "base-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/file/v3/{**catch-all}" }
      },
      "base-custom-route": {
        "ClusterId": "base-cluster",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/base/{**catch-all}" }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": { "destination1": { "Address": "http://auth-service:8080/" } }
      },
      "base-cluster": {
        "Destinations": { "destination1": { "Address": "http://base-service:8080/" } }
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Yarp.ReverseProxy": "Information"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "Logs/logs-.txt",
                "rollingInterval": "Day",
                "rollOnFileSizeLimit": true,
                "fileSizeLimitBytes": 104857600,
                "retainedFileTimeLimit": "7.00:00:00"
              }
            }
          ]
        }
      },
      {
        "Name": "OpenTelemetry",
        "Args": {
          "resourceAttributes": {
            "service.name": "gateway-host"
          }
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console",
              "Args": {
                "theme": "Serilog.Sinks.SystemConsole.Themes.ConsoleTheme::None, Serilog.Sinks.Console"
              }
            }
          ]
        }
      }
    ]
  }
}
