  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "Logs/logs-.txt",
                "rollingInterval": "Day",
                "rollOnFileSizeLimit": true,
                "fileSizeLimitBytes": 104857600,
                "retainedFileTimeLimit": "7.00:00:00"
              }
            }
          ]
        }
      },
      {
        "Name": "OpenTelemetry",
        "Args": {
          "resourceAttributes": {
            "service.name": "auth-host"
          }
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            { "Name": "Console", "Args": { "theme": "Serilog.Sinks.SystemConsole.Themes.ConsoleTheme::None, Serilog.Sinks.Console" } }
          ]
        }
      }
    ]
  },
  "OpenIddict": {
    "IssuerUri": "https://localhost:7233",
    "Applications": {
      "DredgeAI_Web": {
        "ClientId": "DredgeAI_Web",
