# DredgeAI.BidCompare 本地密钥（复制为 .env 后填写；.env 已在 .gitignore，禁止提交）
# 注意：仓库根目录的 .env 是统一入口，后端启动时会向上查找并加载；此文件仅为变量清单。

# PostgreSQL 连接串（Host 与 DbMigrator 共用；本地开发容器默认 postgres/postgres，生产必换）
BIDCOMPARE_DB_CONNECTION="Host=localhost;Port=5432;Database=BidCompare;User ID=postgres;Password=CHANGE_ME"

# MinIO / S3 对象存储（Storage:Provider=S3 时必填；须与所连 MinIO 实例一致）
STORAGE_S3_ACCESSKEY=CHANGE_ME
STORAGE_S3_SECRETKEY=CHANGE_ME

# 本地存储签名 URL 密钥（Storage:Provider=Local 时必填；生产务必使用高强度随机值）
STORAGE_LOCAL_SIGNING_SECRET=CHANGE_ME

# ABP 字符串加密密钥（生产必填）
STRING_ENCRYPTION_PASSPHRASE=CHANGE_ME

# AnGIneer 文档解析服务
ANGINEER_API_KEY=

# LLM 网关
LLM_API_KEY=
LLM_ENDPOINT=
LLM_MODEL=

# 生产环境建议
AUTH_REQUIRE_HTTPS_METADATA=true
SWAGGER_ENABLED=false

# OpenIddict 客户端（环境变量注入，Host 与 DbMigrator 均生效；避免依赖 CWD 的 appsettings 加载）
OpenIddict__Applications__BidCompare_Swagger__ClientId=BidCompare_Swagger
OpenIddict__Applications__BidCompare_Swagger__RootUrl=https://localhost:44361
OpenIddict__Applications__BidCompare_App__ClientId=BidCompare_App
