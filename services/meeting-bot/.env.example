# meeting-bot 服务配置（复制为 services/meeting-bot/.env 生效）
MEETING_BOT_KEY=dev-key

# 引擎选择：mock | firered / firered / insightface / yolo
ASR_ENGINE=firered
TTS_ENGINE=firered
FACE_ENGINE=insightface
COUNT_ENGINE=yolo

# 模型目录：统一放在 DredgeAI 仓库外的共享模型仓库（本机默认）
MODEL_DIR=D:/AI/AImodles/models

# FireRedASR：auto=本机有 GPU 则 CUDA，否则 CPU；本机 8GB 显存建议 CPU
ASR_DEVICE=auto

# FireRedTTS-1S：建议 cuda + fp16（8GB 显存）；CPU 合成很慢仅兜底
TTS_DEVICE=auto
TTS_VENV_PYTHON=
TTS_PRETRAINED_DIR=
TTS_PROMPT_WAV=
TTS_PROMPT_TEXT=

# InsightFace：cpu | gpu
FACE_PROVIDERS=cpu
FACE_RECOGNIZE_THRESHOLD=0.55

# YOLO 人数：cpu | cuda
COUNT_DEVICE=cpu
